# OS / IDE
.DS_Store
.AppleDouble
.LSOverride

# Cursor local cache (keep .cursor/rules/ in git for Cloud Agents)
.cursor/plans/
.cursor/projects/
.cursor/*.log

# Vault sync controls
.vault-sync-off
.vault-sync-conflict

# Secrets and local overrides
.env
.env.*
!.env.example
!**/.env.example
**/ДОСТУПЫ*.md
**/*_ДОСТУПЫ*.md
*.pem
*.pkey
id_rsa
id_ed25519

# Large media (transcripts .md stay in git)
*.m4a
*.webm
*.mp4
*.mov

# Typo duplicate folder (use Бизнес/ only)
Бizнес/

# Embedded git clone (infra vendor, not part of vault)
Бизнес/99_Системное/Инфра/TrustTunnel/

# Vault sync logs (local only)
Бизнес/99_Системное/Скрипты_vault/git/logs/*
!Бизнес/99_Системное/Скрипты_vault/git/logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Build / logs
*.log
dist/
build/
