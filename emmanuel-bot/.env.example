# Токен @BotFather (не коммитьте реальный токен)
BOT_TOKEN=

# ID группового чата (например -1001234567890). 0 — тест: без проверки членства и без постинга в группу.
GROUP_CHAT_ID=0

# SQLite путь внутри контейнера (volume в compose)
DATABASE_URL=sqlite+aiosqlite:////data/emmanuel.sqlite3

# Логи: INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Groq — оставь пустым, если не нужны «напутствие», дайджест и коммент к статистике
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
