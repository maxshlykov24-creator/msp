# Скопируй в .env на заграничном exit-VPS.
# Публичный IP этого VPS:
WG_HOST=203.0.113.10
# Хэш пароля веб-UI wg-easy. Сгенерировать:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'ТВОЙ_ПАРОЛЬ'
# Вставь СЮДА полученный хэш (кавычки/$ экранировать по правилам твоего .env).
PASSWORD_HASH=$2a$12$REPLACE_WITH_GENERATED_HASH
