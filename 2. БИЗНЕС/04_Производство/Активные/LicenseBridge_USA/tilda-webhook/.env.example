# ── Kommo ──
KOMMO_TOKEN=
KOMMO_BASE=https://licensebridgeusa.kommo.com/api/v4
KOMMO_ACCOUNT_ID=34679511

# Воронки/этапы (AS-IS)
PIPELINE_ID=11274779
STATUS_NEW=108112044
ASSEMBLY_PIPELINE_ID=12079591
ASSEMBLY_STATUS_START=93231787   # «Заполняют анкету» — старт Сборки после handoff

# Ответственные
DEFAULT_SALES_OWNER_ID=15648532   # Александра (РОП) — новые не-телефонные лиды + fallback (была Илона 15537380, уволена 19.08.2026)
CLIENT_DEPT_OWNER_IDS=15293564    # Полина (клиентский отдел) — вне автораспределения
# Ушедшие из команды: в Kommo их оставляют активными ради истории, поэтому
# перечисляем явно — иначе вернувшийся клиент наследует карточку уволенного.
DEPARTED_OWNER_IDS=15537380       # Илона, уволена 19.08.2026

# ── Handoff Pipeline → Сборка (won создаёт новую сделку в производстве) ──
HANDOFF_OWNER_ID=15293564        # Полина — фиксированный ответственный новой сделки
ENABLE_HANDOFF=false             # вручную после smoke-теста на боевом (вне авто-раскатки)
HANDOFF_BACKDATE=true            # created_at новой = created_at исходной (лента подтягивает чаты/звонки)
HANDOFF_COPY_NOTES=true          # копировать примечания + дайджест звонков/чата
HANDOFF_TAG=сборка_из_продажи
HANDOFF_MAX_PER_HOUR=20          # защита от петли/массового перетаскивания

# ── Алерты в Telegram ──
# Пусто → проверки работают, но пишут только в лог. Токен нужен один: наблюдатель
# на Asterisk шлёт свои алерты через хаб (POST /internal/alert).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITOR_INTERVAL_SEC=300
MONITOR_WORKDAY_START_HOUR=9      # по TZ ниже
MONITOR_WORKDAY_END_HOUR=18
MONITOR_SILENCE_HOURS=3           # столько тишины на добавочном в смену = алерт
MONITOR_LEAD_BURST_PER_HOUR=25    # выше — похоже на дубль-шторм Make.com (был 11.08)
MONITOR_SPAM_CHECK_DAYS=30        # напоминание сверить spam-статус в Hiya и FCR
MONITOR_DIGEST_HOUR=9             # утренняя сводка: её отсутствие = хаб умер
ALERT_NEW_LEAD=true               # уведомление в Telegram на каждую новую заявку (просьба 28.08)
CHAT_SILENCE_HOURS=1              # клиент написал, человек молчит; ответ бота не считается
CHAT_DIGEST_DAYS=60               # окно чтения переписки из /events (см. app/chat_events.py)
OWNER_SWEEP_INTERVAL_SEC=3600     # как часто искать сделки продаж, осевшие на «не продавце»

# ── БД ──
DATABASE_URL=postgresql+psycopg2://lbhub:lbhub@db:5432/lbhub

# ── Входящие каналы ──
PLEEP_API_KEY=
KOMMO_WEBHOOK_SECRET=            # path-secret: POST /kommo/webhook/{secret}
INTERNAL_API_KEY=               # для POST /internal/responsible/resolve (телефония)

# ── Режим ──
RUN_MODE=api                    # api | worker (в docker задаётся на сервис)

# ── Авто-раскатка (решения по этапам принимает сервер) ──
AUTO_ROLLOUT=true               # 0 shadow → 1 распределение → 2 сделки → 3 контакты → 4 лёгкий чат
ROLLOUT_SHADOW_HOURS=24         # наблюдение до первых изменений в Kommo
ROLLOUT_STAGE_HOURS=24          # выдержка каждого следующего этапа
ROLLOUT_MIN_DECISIONS=20        # минимум решений в shadow до выхода из него
ROLLOUT_MAX_DEADLETTER=0        # ошибки обработки → продвижение останавливается
ROLLOUT_MAX_PENDING=100         # затор очереди → продвижение останавливается

# ── Ручные флаги (нужны только при AUTO_ROLLOUT=false или для форс-включения) ──
SHADOW_MODE=true                # true = считать решения, Kommo не менять
INTAKE_CREATE_IN_SHADOW=true    # создавать лиды из Tilda/Pleep даже в shadow (не терять входящие)
ENABLE_ASSIGNMENT=false
ENABLE_DEAL_DEDUP=false
ENABLE_CROSS_FUNNEL=false
ENABLE_CONTACT_SOFT_MERGE=false
ENABLE_LIGHT_CHAT_MERGE=false

# ── Телефония (Asterisk 159.65.97.156) ──
ENABLE_TELEPHONY=false           # включить после дымового прогона диалплана
# карта добавочных: по ней звонок подписывается тем, кто говорил. Уволили менеджера
# в Kommo — сразу править здесь, иначе примечания-звонки отбиваются NotSupportedChoice
# 101 — Павел, он садится на линию 1 сменами. В карте он нужен всегда, иначе его
# звонки попадают в Kommo без автора (проверено 31.08: строку затёрло деплоем)
TELEPHONY_EXT_USERS=102:15293564,103:15648532,101:13291175  # Полина / Александра (РОП) / Павел
# Смену линии 1 держит lb-line1-auto.sh на сервере, эти две строки — состояние «вне смены»
TELEPHONY_SALES_ORDER=103        # круг продаж вне смены Павла: одна линия, РОП
TELEPHONY_DID_EXT=1:103,3:103    # SIM-порт → владелец прямого номера; вне смены линия 1 на РОП
TELEPHONY_MISSED_OWNER_ID=15648532   # Александра (РОП) — пропущенный без известного ответственного
TELEPHONY_SERVICE_OWNER_ID=15293564  # Полина — «2 — обслуживание» на 102, не ответила
TELEPHONY_TASK_MINUTES=60
# Сторож дозвона: за это поведение движки операторов и метят номер спамом.
# warn — считаем нарушения и пишем в лог, block — не пускаем набор (перед
# включением записать подсказку в трубку), off — не спрашивать.
DIAL_GUARD_MODE=block
DIAL_GUARD_HARD_GAP_SEC=90       # мгновенный повторный набор на тот же номер
DIAL_GUARD_MIN_GAP_MIN=15        # после любого набора
DIAL_GUARD_SECOND_GAP_MIN=180    # после второго недозвона, минуты
DIAL_GUARD_REACTIVATION_HOURS=24
DIAL_GUARD_MAX_PER_DAY=3         # исходящих наборов на номер в сутки
STATUS_REACTIVATION=110600324    # этап Reactivation в Pipeline
TELEPHONY_SOURCE=asterisk_lb
TELEPHONY_CHANNEL=Входящий звонок
RECORDINGS_URL=http://159.65.97.156:8088/recordings  # каталог закрыт файрволом, ходит только хаб
PUBLIC_BASE_URL=https://72-56-123-137.sslip.io
REC_LINK_SECRET=                 # пусто → берётся INTERNAL_API_KEY

# ── Лид-машина: WhatsApp → AI-звонок Pleep → SMS ──
ENABLE_LEADFLOW=false            # включать после сквозного прогона (вне авто-раскатки)
STATUS_FIRST_TOUCH=86527439      # «Первичный контакт»
STATUS_QUALIFICATION=96943275    # «Квалификация»
STATUS_IN_WORK=106419976         # «В работе» — куда лид уходит после квалификации AI
FIELD_WA_VARIANT=1420023         # поле сделки: какой вариант первого сообщения слать
FIELD_CALL_WINDOW=1420025        # поле сделки: окно звонка по местному времени клиента
WA_VARIANT_COUNT=4               # сколько вариантов текста заведено в Salesbot
PLEEP_NUMBER=+18188066735        # идентификатор агента в SIP URI на sip.rtc.elevenlabs.io, не номер для звонка извне
CALL_WINDOW_START_HOUR=9         # раньше клиенту не звоним (его местное время)
CALL_WINDOW_END_HOUR=20          # позже клиенту не звоним
CALL_WINDOW_DEFAULT_TZ=America/New_York  # номер без узнаваемой зоны
AI_CALL_MAX_ATTEMPTS=2
AI_CALL_RING_SEC=45
AI_CALL_SWEEP_INTERVAL_SEC=60    # как часто worker проверяет отложенные звонки
SMS_BOT_ID=0                     # id нового SMS-бота RingCentral; 0 → вместо SMS задача
LEADFLOW_TASK_MINUTES=30
TAG_DO_NOT_CALL=не звонить
# AMI Asterisk — только Originate AI-звонка; порт 5038 открыт лишь для IP хаба
AMI_HOST=159.65.97.156
AMI_PORT=5038
AMI_USER=lbhub
AMI_SECRET=
AMI_OUTBOUND_CONTEXT=lb-ai-outbound
AMI_CONNECT_CONTEXT=lb-ai-connect

# ── Дубли: удаления в API Kommo нет (405), помечаем тегом ──
ARCHIVE_PIPELINE_ID=0           # 0 = дубль остаётся на месте с тегом «дубль_удалить»
ARCHIVE_STATUS_ID=0             # иначе id воронки/этапа «Архив дублей»

# ── Пороги/тюнинг ──
SHARED_PHONE_THRESHOLD=3
LIGHT_CHAT_MAX_MESSAGES=5
SCANNER_INTERVAL_MIN=180
SCANNER_AUTOQUEUE=true
TAG_RECLAIM_INTERVAL_HOURS=168
MERGE_SLOTS_CONTACTS=20
MERGE_SLOTS_DEALS=20
TZ=America/New_York
