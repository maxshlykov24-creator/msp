# === Комбикорм-бот (Александр) ===
# Скопируй в .env и заполни. Файл .env не коммитим.

# Telegram (от @BotFather)
TELEGRAM_BOT_TOKEN=

# Nexara STT (ключ из кабинета app.nexara.ru → API keys)
NEXARA_API_KEY=

# Пути к данным (на VPS: /var/lib/kombikorm-bot)
DATA_DIR=./data
LOG_DIR=./data/logs

# Мессенджер: telegram (сейчас) | max (позже)
MESSENGER=telegram

# Порог матчинга (0..100), ниже — строка уходит в "❓ не распознано"
MATCH_THRESHOLD=72

# LLM-фолбэк для нераспознанных строк: 0 = выкл (по умолчанию), 1 = вкл
# Бесплатный tier: https://console.groq.com → API Keys → gsk_...
LLM_FALLBACK_ENABLED=0
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Куда слать ежедневную копию БД (chat_id владельца). Пусто = не слать.
BACKUP_CHAT_ID=

# Макс. число пользователей в whitelist (первые, кто нажал /start)
MAX_WHITELIST=2
