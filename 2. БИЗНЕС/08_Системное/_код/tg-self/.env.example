# Свои api_id и api_hash с my.telegram.org → API development tools
# Не подставлять публичные 2040 / чужие ключи: Telegram такие сеансы снимает
TELEGRAM_API_ID=
TELEGRAM_API_HASH=


# Необязательно: номер в международном формате, чтобы login меньше спрашивал
# TELEGRAM_PHONE=+79XXXXXXXXX
# TELEGRAM_PHONE_WORK=+79XXXXXXXXX
# TELEGRAM_PHONE_LEARN=+79XXXXXXXXX
# TELEGRAM_PASSWORD=
# TELEGRAM_PASSWORD_WORK=
# TELEGRAM_PASSWORD_LEARN=
