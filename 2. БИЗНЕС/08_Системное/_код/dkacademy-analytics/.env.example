# ── amoCRM ──
AMO_BASE_URL=https://dkdkacademy.amocrm.ru
# Долгосрочный токен (Bearer). НЕ коммитить реальное значение.
AMO_ACCESS_TOKEN=PASTE_LONG_LIVED_TOKEN_HERE

# ── База данных (внутри docker-сети, переопределяется в compose) ──
DATABASE_URL=postgresql+psycopg2://dkanalytics:dkanalytics@db:5432/dkanalytics

# ── Авторизация (форма входа) ──
AUTH_LOGIN=maxim
# bcrypt-хеш пароля. Сгенерировать:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'Maxim123',bcrypt.gensalt()).decode())"
# ВАЖНО: docker compose интерполирует $ в env_file. В .env каждый $ экранировать как $$
#   т.е. хеш $2b$12$abc... записывать как $$2b$$12$$abc...
AUTH_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
# Секрет для подписи сессионной куки (любая длинная случайная строка):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=PASTE_RANDOM_SECRET_HERE

# ── Расписание сбора ──
TZ=Europe/Moscow
COLLECT_INTERVAL_MIN=10
COLLECT_HOURS=7-22

# ── Воронки amoCRM (id) ──
PIPELINE_SALES=10694702
PIPELINE_REPEAT=10697570
STATUS_WON=142
STATUS_LOST=143
STATUS_NEW=84270034
STATUS_INVOICE=84291534
STATUS_NOANSWER=84313150
STATUS_WAITLIST=84291530

# ── Канонический состав менеджеров (id через запятую) ──
# Активные не-администраторы на 2026-07-20:
# Финюк, Судакова, Пузанова, Филатова, Воробцова, Соломахина.
MANAGER_USER_IDS=13611590,13611594,13793718,13803674,13860306,13961174
# Явное исключение уволенной Алины; allowlist выше также убирает админов и дубли.
EXCLUDED_USER_IDS=8547745
