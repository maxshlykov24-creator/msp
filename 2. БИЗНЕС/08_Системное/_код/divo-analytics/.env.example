# ── amoCRM ──
AMO_BASE_URL=https://divomotors.amocrm.ru
AMO_ACCOUNT_ID=32590598
# Долгосрочный токен (Bearer). НЕ коммитить реальное значение.
AMO_ACCESS_TOKEN=PASTE_LONG_LIVED_TOKEN_HERE

# ── База данных (внутри docker-сети, переопределяется в compose) ──
DATABASE_URL=postgresql+psycopg2://divoanalytics:divoanalytics@db:5432/divoanalytics

# ── Авторизация (форма входа) ──
AUTH_LOGIN=divo
# bcrypt-хеш пароля. Сгенерировать:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'ПАРОЛЬ',bcrypt.gensalt()).decode())"
# ВАЖНО: docker compose интерполирует $ в env_file. В .env каждый $ экранировать как $$
#   т.е. хеш $2b$12$abc... записывать как $$2b$$12$$abc...
AUTH_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
# Доп. учётки, через точку с запятой. Хеш экранировать $$ как у AUTH_PASSWORD_HASH.
# AUTH_USERS=max:$$2b$$12$$...
# Секрет для подписи сессионной куки (любая длинная случайная строка):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=PASTE_RANDOM_SECRET_HERE
# true на проде (HTTPS). Для локального http://127.0.0.1 без TLS — false,
# иначе браузер не примет cookie и вход зациклится на /login.
AUTH_COOKIE_SECURE=true

# ── Расписание сбора ──
TZ=Europe/Moscow
COLLECT_INTERVAL_MIN=10
COLLECT_HOURS=0-23

# ── Воронка «Продажи» DIVO Motors (id) ──
PIPELINE_SALES=10372290
STATUS_WON=142
STATUS_LOST=143

# ── Менеджеры отдела продаж, попадающие в дашборд (whitelist) ──
ALLOWED_MANAGER_IDS=13180098,13334858,13835174
MANAGER_KEY_MAP=13180098:eugene,13334858:nikita,13835174:elzar

# ── Custom fields (id) ──
FIELD_SOURCE=2026903
FIELD_PAYMENT_TYPE=2026901
FIELD_TRADE_IN=2026907
FIELD_LOSS_REASON=2026915
FIELD_AGREED=2027799
FIELD_VISIT_PLANNED=2258985
FIELD_VISIT_DONE=2026919
