# ── Kommo (только чтение) ──
# Долгоживущий токен интеграции. Тот же аккаунт, что у хаба LicenseBridge.
KOMMO_TOKEN=PASTE_TOKEN_HERE
KOMMO_BASE=https://licensebridgeusa.kommo.com/api/v4
KOMMO_ACCOUNT_ID=34679511
PIPELINE_MAIN=11274779
PIPELINE_SBORKA=12079591

# ── Вход ──
AUTH_LOGIN=licensebridge
# bcrypt-хеш пароля:
#   python3 -c "import bcrypt;print(bcrypt.hashpw(b'ПАРОЛЬ',bcrypt.gensalt()).decode())"
# В .env для docker compose каждый $ экранировать как $$ (иначе compose съест $2b/$12):
#   AUTH_PASSWORD_HASH=$$2b$$12$$....
AUTH_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=PASTE_RANDOM_SECRET_HERE
# false только для локального http://127.0.0.1, иначе браузер не примет cookie
AUTH_COOKIE_SECURE=true

# ── Расписание ──
TZ=Europe/Moscow
COLLECT_INTERVAL_MIN=30
# Старше этого возраста срез считается несвежим → красный баннер в дашборде
STALE_AFTER_HOURS=2
