# Бот администратора Keris Club: фото до/после (@kerisclubphotobot).
# Токен и ID в git не кладём — только на сервере в /root/keris-staff-bot/.env
STAFF_BOT_TOKEN=
# Telegram ID администраторов через запятую. Пусто — доступ открыт всем, кто знает бота.
STAFF_TELEGRAM_IDS=
KERIS_SERVER_URL=http://127.0.0.1:8091
# Тот же ключ, что у keris-server, иначе admin-API вернёт 401.
ADMIN_API_KEY=
STATE_FILE=/root/keris-staff-bot/state.json
