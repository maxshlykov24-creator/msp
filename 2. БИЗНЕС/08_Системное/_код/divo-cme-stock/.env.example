# ── CM.Expert OAuth2 Client Credentials ──
# Логин в ЛК ≠ эти ключи. Запрос: help@cm.expert (см. README).
CME_CLIENT_ID=
CME_CLIENT_SECRET=
CME_BASE_URL=https://lk.cm.expert
CME_USER_AGENT=divo-cme-stock (info@msproduct.ru)

# Фильтр «на площадке». require = без поля публикации не пишем в таблицу.
# in_stock_only = только stockState=in + saleStatus=onsale (после подтверждения probe).
CME_PUBLISH_MODE=require
# Имя поля в JSON, если автодетект не сработал (после probe):
CME_PUBLISH_FIELD=
# Салон, чей сток идёт в таблицу. В аккаунте их несколько (probe 27.08):
# DIVO MOTORS = 15371. Пусто = все салоны (для DIVO так нельзя).
CME_DEALER_ID=15371

# ── Google Sheets ──
GOOGLE_SA_PATH=google_sa.json
SPREADSHEET_ID=1icRyb3qObLM80b2S-zvwIttB808FIsDM8kB5Wu9u23Q
DATA_SHEET=Данные
SHEET1_NAME=Sheet1
# RAW: строки как есть («2,00», «13 890»). USER_ENTERED — Sheets сам парсит числа.
SHEETS_VALUE_INPUT=RAW

# ── Состояние и страховки ──
STATE_PATH=data/state.json
DROP_RATIO=0.5
ALLOW_EMPTY=0

# ── Расписание ──
TZ=Europe/Moscow
SYNC_INTERVAL_MIN=15

# ── Telegram-алерт (три неуспешных прогона подряд) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
