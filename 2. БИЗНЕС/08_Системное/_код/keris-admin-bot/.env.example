# keris-admin-bot — личный бот Карины. Копировать в .env на сервере, не коммитить.

KARINA_BOT_TOKEN=
# Пустой список никого не пускает. Оперативные пуши Карины остаются пустыми,
# иначе то же событие придёт второй раз.
KARINA_TELEGRAM_IDS=
# Роли внутри бота. На сборке оба списка — аккаунт Максима.
ADMIN_ROLE_IDS=
KARINA_ROLE_IDS=

KERIS_SERVER_URL=http://127.0.0.1:8091
ADMIN_API_KEY=CHANGE_ME
STATE_FILE=/root/keris-admin-bot/state.json
