# ── amoCRM (только чтение) ──
AMOCRM_BASE=https://kerisclub.amocrm.ru
AMOCRM_TOKEN=PASTE_TOKEN_HERE
AMOCRM_ACCOUNT_ID=33117150

# ── Postgres груминга, желательно роль только SELECT ──
# Тот же инстанс, что у keris-server. Не вешаем collector на прод-процесс записи.
DATABASE_URL=postgresql+psycopg://keris_analytics:CHANGE_ME@127.0.0.1:5432/keris_grooming

# ── Вход ──
AUTH_LOGIN=karina
# python3 -c "import bcrypt;print(bcrypt.hashpw(b'ПАРОЛЬ',bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=PASTE_RANDOM_SECRET_HERE
AUTH_COOKIE_SECURE=true
# за nginx /pulse/ — ставить /pulse
AUTH_COOKIE_PATH=/pulse

# ── Расписание ──
TZ=Europe/Moscow
COLLECT_INTERVAL_MIN=15
STALE_AFTER_HOURS=2
DATA_DIR=/root/keris-analytics/data
RUN_SCHEDULER=true
