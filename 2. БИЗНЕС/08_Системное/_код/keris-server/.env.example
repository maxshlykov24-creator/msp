# Keris Server — Этап 2 (Груминг). Копировать в .env на сервере, не коммитить.

# --- База данных ---
DATABASE_URL=postgresql+psycopg://keris:CHANGE_ME@localhost:5432/keris_grooming
# для локальной разработки без Postgres можно: sqlite:///./keris_dev.db

# --- YCLIENTS (developer.yclients.com) ---
# Partner ID 20148; Partner Token — «Аккаунт разработчика» → «Настройки аккаунта»
YCLIENTS_PARTNER_TOKEN=7heEa86en6Bf9Z1wbwX7
# User Token — «Мои приложения» → «Доступ к API» (подтверждён)
YCLIENTS_USER_TOKEN=12a6eb3f0f7b80398dd01fad020bc5ef
YCLIENTS_COMPANY_ID=2101965
YCLIENTS_APPLICATION_ID=47925
YCLIENTS_WEBHOOK_SECRET=CHANGE_ME

# Доп. поля записи (Настройки → Дополнительные поля → «Ключ для API» каждого поля).
# Заведены 2026-08-17: Кличка/Порода/Вес/Дата рождения питомца.
YCLIENTS_CF_PET_NAME=klichka-pitomtsa
YCLIENTS_CF_PET_BREED=poroda-pitomtsa
YCLIENTS_CF_PET_WEIGHT=ves-pitomtsa
YCLIENTS_CF_PET_BIRTH_DATE=data-rozhdeniya-pitomtsa

# --- amoCRM (api v4) ---
# Домен аккаунта, а не api_domain из токена: на api-b.amocrm.ru тот же токен
# отвечает 401 Account not found (из-за этого интеграцию считали мёртвой).
AMOCRM_BASE_URL=https://kerisclub.amocrm.ru
AMOCRM_LONG_LIVED_TOKEN=
# Воронка «Груминг» (setup_grooming_pipeline.py). Этапы и поля резолвятся по имени.
AMOCRM_PIPELINE_GROOMING_ID=11225138
AMOCRM_FIELD_CLIENT_GROOMING=1820905
# Клиент без визита дольше N дней — «Спящий» / «Потерянный» в метриках контакта.
AMOCRM_SLEEPING_DAYS=60
AMOCRM_LOST_DAYS=120

# --- Админ-бот Карины ---
KARINA_BOT_TOKEN=
KARINA_TELEGRAM_IDS=

# --- Бот-уведомитель для админов (@kerisclub_notify_bot), доп. широкий круг ---
ADMIN_NOTIFY_BOT_TOKEN=
ADMIN_NOTIFY_CHAT_IDS=

# --- Клиентские боты (напоминания) ---
CLIENT_BOT_TOKEN=
MAX_BOT_TOKEN=

# --- SMS-уведомления (targetsms.ru), с 2026-08-24 ---
# Платный канал, по умолчанию выключен. Авторизация — Bearer-токен из кабинета
# sms.targetsms.ru, не логин/пароль входа на сайт. Отправитель KerisClub
# прошёл модерацию 24.08.2026, без него шлюз отвечает «Нет отправителя».
# Включает: SMS при записи (любой источник) + напоминания 24ч/3ч.
# Код входа в кабинет по SMS не шлётся — только Telegram и MAX.
TARGETSMS_ENABLED=false
TARGETSMS_TOKEN=
TARGETSMS_SENDER=KerisClub

# --- API ---
ADMIN_API_KEY=CHANGE_ME
HOST=127.0.0.1
PORT=8091
