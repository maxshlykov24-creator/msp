# MoySklad JSON API (Remap 1.2)
MS_TOKEN=
API_BASE=https://api.moysklad.ru/api/remap/1.2

# PostgreSQL (docker-compose default)
DATABASE_URL=postgresql+psycopg2://loyalty:loyalty@db:5432/loyalty

# Public URL (для register_webhooks.py), полный путь /webhook/moysklad
# WEBHOOK_PUBLIC_URL=https://your-host.twc1.net/webhook/moysklad
# Optional: if reverse proxy adds header X-Loyalty-Secret
WEBHOOK_SECRET=

# Status names (must match MoySklad order states exactly)
STATUS_DELIVERED=Доставлен
STATUS_RETURN_FULL=Возврат
STATUS_RETURN_PARTIAL=Частичный возврат

# External code marker for our bonus transactions (skip in bonustransaction webhook)
LOYALTY_EXTERNAL_CODE=loyalty-service

# Comma-separated product folder UUIDs (native id) to treat as outlet (no earn)
OUTLET_FOLDER_IDS=
# Comma-separated folder UUIDs for gift certificates (no earn/spend via engine)
GIFT_FOLDER_IDS=
# Comma-separated folder UUIDs for delivery lines (excluded from earn & annual sum)
DELIVERY_FOLDER_IDS=

# Optional: counterparty custom attribute UUIDs (from metadata) — if empty, tier/sum only in local DB
# ATTR_LOYALTY_TIER=
# ATTR_ANNUAL_SUM_RUB=
# ATTR_ENROLLED_AT=
# ATTR_LAST_TIER_REVIEW=
# ATTR_TIER_LOCKED=

# Deferred bonus days (MoySklad Extended bonus program)
BONUS_DELAY_DAYS=15

# Scheduler
RECONCILIATION_LOOKBACK_DAYS=2

# One-shot bonuses (0 = off)
WELCOME_BONUS_POINTS=0
BIRTHDAY_BONUS_POINTS=0
# Optional: counterparty custom attribute id for date of birth (for sync_birthdays_from_moysklad)
# ATTR_BIRTHDATE=
