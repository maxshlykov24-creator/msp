# WireGuard клиент для RU VPS (split-routing к Telegram).
# Скопируй в wg/wg0.conf и подставь значения из клиентского .conf, выданного wg-easy
# на заграничном exit-узле (см. exit-node/). НЕ коммить готовый wg0.conf — он в .gitignore.
#
# КЛЮЧЕВОЙ момент split-routing: AllowedIPs = ТОЛЬКО подсети Telegram (не 0.0.0.0/0),
# иначе через тоннель уйдёт весь трафик и можно отрезать SSH к хосту / доступ к БД.

[Interface]
# Приватный ключ и адрес — из клиентского конфига wg-easy
PrivateKey = <CLIENT_PRIVATE_KEY>
Address = 10.8.0.2/24
# DNS не задаём: резолвинг оставляем системный, чтобы не гнать DNS через тоннель.

[Peer]
# Публичный ключ сервера wg-easy (exit-узел)
PublicKey = <SERVER_PUBLIC_KEY>
# Общий ключ, если wg-easy его выдал (иначе строку удалить)
PresharedKey = <PRESHARED_KEY>
# Публичный IP заграничного exit-VPS и порт (по умолчанию у wg-easy 51820)
Endpoint = <EXIT_VPS_PUBLIC_IP>:51820
# Только подсети Telegram -> split-routing. Источник: telegram-subnets.txt
AllowedIPs = 149.154.160.0/20, 185.76.151.0/24, 91.105.192.0/23, 91.108.4.0/22, 91.108.8.0/22, 91.108.12.0/22, 91.108.16.0/22, 91.108.20.0/22, 91.108.56.0/22
# Держим тоннель живым за NAT
PersistentKeepalive = 25
