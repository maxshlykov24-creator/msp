# Скопируй в .env и заполни. Файл .env в .gitignore — секреты не коммитим.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# --- PostgreSQL (данные остаются на RU VPS, 152-ФЗ) ---
POSTGRES_USER=botuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=botdb
# Строка подключения для бота (host = db, т.к. резолвится в docker-сети)
DATABASE_URL=postgresql://botuser:change_me_strong_password@db:5432/botdb

# --- Прочее ---
TZ=Europe/Moscow

# --- Только для webhook / Web App (иначе не нужно) ---
# Домен, указывающий A-записью на RU VPS. Используется в caddy/Caddyfile.
# WEBHOOK_DOMAIN=bot.example.ru
