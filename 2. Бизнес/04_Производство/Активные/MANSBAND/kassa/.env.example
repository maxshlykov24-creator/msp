# ── MANSBAND Касса — пример окружения ───────────────────────────────
# Скопируй в .env (на сервере) и заполни. Реальные значения — в
# MANSBAND/_private/kassa_access.env. .env НИКОГДА не коммитить.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ── PostgreSQL (для docker-compose) ─────────────────────────────────
POSTGRES_USER=kassa
POSTGRES_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=kassa
# DATABASE_URL формируется в compose из переменных выше; для локали:
# DATABASE_URL=postgres://kassa:kassa@localhost:5432/kassa

# ── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=ЗАМЕНИ_длинная_случайная_строка_минимум_32_символа
JWT_EXPIRES_IN=12h

# ── amoCRM ──────────────────────────────────────────────────────────
AMOCRM_API_BASE=https://mansband.amocrm.ru/api/v4
AMOCRM_LONG_LIVED_TOKEN=ВСТАВЬ_ТОКЕН
AMOCRM_PIPELINE_SALES=9601214
AMOCRM_PIPELINE_COMPLAINTS=9601246

# ── МойСклад ────────────────────────────────────────────────────────
MOYSKLAD_API_BASE=https://api.moysklad.ru/api/remap/1.2
MOYSKLAD_API_TOKEN=ВСТАВЬ_ТОКЕН

# ── Сид пользователей (оба админы) ──────────────────────────────────
# Если пароль не задан — сгенерируется и распечатается при seed (сменить при первом входе).
SEED_ADMIN_LOGIN=max
SEED_ADMIN_NAME=Максим
SEED_ADMIN_PASSWORD=
SEED_MISHA_LOGIN=misha
SEED_MISHA_NAME=Миша
SEED_MISHA_PASSWORD=

# ── Webhooks ────────────────────────────────────────────────────────
WEBHOOK_SECRET=ЗАМЕНИ_секрет_для_вебхуков
PUBLIC_BASE_URL=https://mansband-kassa.ru

# ── Синхронизация ───────────────────────────────────────────────────
SYNC_INTERVAL_MIN=30

# ── Telegram (Фаза 4, опционально) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_BAUMANSKAYA=
TELEGRAM_GROUP_PYATNITSKAYA=
