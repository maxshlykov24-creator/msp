# Обычный REST API v5 ключ RetailCRM (Настройки -> Администрирование -> Пользователи -> API-ключи)
# Нужно право на редактирование интеграционных модулей.
RETAILCRM_API_URL=https://ваш-аккаунт.retailcrm.ru
RETAILCRM_API_KEY=

# Заполняется автоматически register_bot.py после регистрации bot-модуля
RETAILCRM_MG_BOT_TOKEN=
RETAILCRM_MG_BOT_ENDPOINT=

# Код и имя служебного модуля-выгрузчика (можно оставить по умолчанию)
BOT_MODULE_CODE=martache-chat-export
BOT_MODULE_NAME=MartaChe Chat Export
# Произвольный уникальный идентификатор клиента для этой интеграции
BOT_CLIENT_ID=martache-export-001
# Не обязателен к реальной доступности — просто идентификатор модуля в RetailCRM
BOT_BASE_URL=https://export.martache.local

# Пауза между запросами к API, сек (защита от rate-limit)
RATE_LIMIT_DELAY=0.3
