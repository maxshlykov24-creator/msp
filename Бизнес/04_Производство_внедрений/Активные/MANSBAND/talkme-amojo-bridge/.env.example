# Скопируйте в .env и заполните. Секреты не коммитить.
DATABASE_URL=postgresql+psycopg2://bridge:bridge@db:5432/bridge

# Внешняя интеграция (amoМаркет)
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_SUBDOMAIN=mansband
AMO_BASE_DOMAIN=amocrm.ru
# До OAuth или как запас:
AMO_LONG_LIVED_TOKEN=
REDIRECT_URI=https://mansband-chat-bridge.twc1.net/oauth/callback

# API чатов (после ответа ТП)
AMO_CHANNEL_ID=
AMO_CHANNEL_SECRET=
# после connect (или из ответа ТП; можно не задавать до connect)
AMO_SCOPE_ID=

# Разовая защита internal-ручек (сгенерируйте: openssl rand -hex 16)
INTERNAL_SECRET=

# Talk-me: токен REST из ЛК, URL смотрите в json-doc «Online-чат»
TALKME_API_BASE=https://lcab.talk-me.ru
TALKME_REST_TOKEN=
TALKME_SEND_MESSAGE_PATH=/public/api/online/v1/visitor/message
# Секрет из настроек вебхука Talk-me
TALKME_WEBHOOK_SECRET=
# Логин оператора в Talk-me (для sendToClient → operator.login)
TALKME_OPERATOR_LOGIN=
# true = логировать начало JSON вебхука (ПДн; только на время отладки)
TALKME_RAW_LOG=false

INTEGRATION_TITLE=MansbandTalkmeBridge
AMOJO_HOST=https://amojo.amocrm.ru
