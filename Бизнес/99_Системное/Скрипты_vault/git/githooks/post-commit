#!/bin/sh
# После коммита пушит в origin. Если ветка привязана к upstream — обычный git push.
# Если upstream ещё нет — первый push в main и привязка к origin/main (удобно для vault на GitHub).
# Отключить: GIT_SKIP_AUTO_PUSH=1 git commit ...

if [ "$GIT_SKIP_AUTO_PUSH" = "1" ]; then
  exit 0
fi

if ! git remote get-url origin >/dev/null 2>&1; then
  exit 0
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

if git rev-parse '@{u}' >/dev/null 2>&1; then
  if git push; then
    exit 0
  fi
else
  if git push -u origin HEAD:main; then
    git branch --set-upstream-to=origin/main "$branch" 2>/dev/null || true
    exit 0
  fi
fi

echo "post-commit: не удалось выполнить git push (сеть, права или конфликт на сервере)." >&2
echo "  Исправь и выполни вручную: git push -u origin HEAD:main" >&2
exit 0
