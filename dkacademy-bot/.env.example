# Скопируйте в .env. Секреты не коммитить.
DATABASE_URL=postgresql+psycopg2://dkabot:dkabot@db:5432/dkabot

# amoCRM (интеграция в маркете)
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_SUBDOMAIN=dkacademy
AMO_BASE_DOMAIN=amocrm.ru
AMO_LONG_LIVED_TOKEN=
REDIRECT_URI=https://your-host.example/oauth/callback

# Telegram
TELEGRAM_BOT_TOKEN=

# LiveInform API v2 — api_id из кабинета; не публикуйте
LIVEINFORM_API_ID=
LIVEINFORM_TRACK_URL=https://www.liveinform.ru/api/v2/track/
# Секрет входящего webhook (заголовок задаётся ниже)
LIVEINFORM_WEBHOOK_SECRET=
LIVEINFORM_WEBHOOK_HEADER=X-LiveInform-Secret

# amo: field_id (число) — сделки
AMO_FIELD_LEAD_CDEK=0
AMO_FIELD_LEAD_LIVEINFORM_STATUS=0

# Режим второй сущности: lead_only | catalog
AMO_ORDER_ENTITY=lead_only
AMO_CATALOG_ID=0
AMO_FIELD_CATALOG_CDEK=0
AMO_FIELD_CATALOG_LIVEINFORM_STATUS=0

# amo: контакт — отметка бота и Telegram
AMO_FIELD_CONTACT_TELEGRAM_CHAT_ID=0
AMO_FIELD_CONTACT_TELEGRAM_USER_ID=0
AMO_FIELD_CONTACT_BOT_STARTED_AT=0
# Тип поля «бот запущен» в amo: text (ISO-строка) или date (unix-timestamp)
AMO_FIELD_CONTACT_BOT_STARTED_AT_TYPE=text

# Если контакт не найден: create | reject
ONBOARDING_CONTACT_NOT_FOUND=reject

# Telegram-юзернейм менеджера (без @). Используется в текстах и кнопке «💬 Менеджер»
MANAGER_TELEGRAM_USERNAME=dk_academy

# Шаблон сообщения в Telegram: {tracking} {status_text} {delivery}
TG_NOTIFY_TEMPLATE=📦 Доставка по треку {tracking}:\n{status_text}
