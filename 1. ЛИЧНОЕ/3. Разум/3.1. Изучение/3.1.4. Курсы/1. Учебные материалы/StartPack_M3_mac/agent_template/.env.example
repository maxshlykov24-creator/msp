# AI-Менеджер 1-й линии · переменные окружения для OpenClaw
# Скопируй в .env (без .example) и заполни.
# .env НИКОГДА не коммитить в git.

# ──────────────────────────────────────────────────────────────────────
# ВАРИАНТ A · OpenRouter only (рекомендованный для старта в М3)
# Один ключ → все модели. Простой, понятный, дёшево для одного агента.
# Подробнее — ВЫБОР_МОДЕЛИ.md § 1, путь A.
# ──────────────────────────────────────────────────────────────────────

# Ключ OpenRouter — единый для всех агентов под одним gateway.
# Получить: https://openrouter.ai/keys (оплата из РФ через PDPAI, см. ИНСТРУКЦИЯ_ДОСТУПЫ.md)
OPENROUTER_API_KEY=sk-or-v1-replaceme

# Primary модель и fallback — выбирай по таблице из ВЫБОР_МОДЕЛИ.md § 3.
# ⚠️ Цены и ID меняются. Свежий список: https://openrouter.ai/models
# Для лид-квалификатора по умолчанию (баланс качества/цены):
OPENCLAW_MODEL_PRIMARY=openrouter/anthropic/claude-sonnet-4.6
OPENCLAW_MODEL_FALLBACK=openrouter/google/gemini-3.1-flash-lite

# Альтернативы (раскомментируй и закомментируй текущие если хочешь поменять):
#
#   ── Бюджетный сценарий ──
#   OPENCLAW_MODEL_PRIMARY=openrouter/google/gemini-3.1-flash-lite     # $0.25/$1.50
#   OPENCLAW_MODEL_FALLBACK=openrouter/deepseek/deepseek-v4-flash      # $0.14/$0.28
#
#   ── Премиум сценарий ──
#   OPENCLAW_MODEL_PRIMARY=openrouter/anthropic/claude-opus-latest     # $5/$25
#   OPENCLAW_MODEL_FALLBACK=openrouter/openai/gpt-5.5                  # $5/$30
#
#   ── Длинный контекст (KB-bot) ──
#   OPENCLAW_MODEL_PRIMARY=openrouter/google/gemini-3.1-pro-preview    # 1M ctx, $2/$12
#   OPENCLAW_MODEL_FALLBACK=openrouter/x-ai/grok-4.20                  # 2M ctx, $1.25/$2.50
#
#   ── Денис production (быстрый + дешёвый) ──
#   OPENCLAW_MODEL_PRIMARY=openrouter/x-ai/grok-4.1-fast               # ~$0.20/$1.00
#   OPENCLAW_MODEL_FALLBACK=openrouter/google/gemini-3-flash-preview   # $0.50/$3.00

# ──────────────────────────────────────────────────────────────────────
# ВАРИАНТ B · Hybrid (Ollama Cloud + OpenRouter) — паттерн Дениса
# Дешевле для open-weight моделей (Kimi/Qwen/GLM/DeepSeek через Ollama),
# OpenRouter для премиум (Anthropic/OpenAI/Grok) и fallback.
# Раскомментируй если используешь.
# Подробнее — ВЫБОР_МОДЕЛИ.md § 1, путь B.
# ──────────────────────────────────────────────────────────────────────

# OLLAMA_API_KEY=...                                # https://ollama.com/ → Settings → API keys
# OPENCLAW_MODEL_PRIMARY=ollama/kimi-k2.5            # дешевле через Ollama чем через OpenRouter
# OPENCLAW_MODEL_FALLBACK=openrouter/google/gemini-3-flash-preview
# OPENCLAW_MODEL_COMPACTION=openrouter/anthropic/claude-sonnet-4.6  # как у Дениса

# ──────────────────────────────────────────────────────────────────────
# Telegram канал для этого агента
# ──────────────────────────────────────────────────────────────────────

# Токен бота от BotFather (https://t.me/BotFather → /newbot)
# Один токен = один канал на одного агента.
TG_BOT_TOKEN_LEAD_QUAL=1234567890:AAExampleTokenReplaceMe

# Telegram chat_id менеджера, в который агент шлёт квалифицированные лиды через tools/escalate.sh
# Узнать: написать @userinfobot в Telegram → он покажет твой ID.
# Для группы — добавить бота + @RawDataBot туда → forward сообщение → chat_id (отрицательный).
MANAGER_CHAT_ID=123456789

# ──────────────────────────────────────────────────────────────────────
# Пути на сервере
# ──────────────────────────────────────────────────────────────────────

# Корень workspace агента (где лежат AGENTS.md, IDENTITY.md, _ВЫХОД/, etc.)
# На локальной разработке: ./workspace
# На VPS: /opt/manager-bot/workspace
WORKSPACE_PATH=./workspace

# Путь к папке tools (CLI-stub'ы для экшенов агента)
TOOLS_PATH=./tools

# Опционально: путь к базе знаний компании (markdown-файлы), которая будет
# доступна агенту через `kb_search` tool. Если пусто — KB не подключается.
# Пример: символлинк на твой второй мозг М2.
KB_PATH=

# ──────────────────────────────────────────────────────────────────────
# Логирование и тестирование
# ──────────────────────────────────────────────────────────────────────

# Куда писать логи tool-вызовов (escalate, save_lead, kb_search) для аудита.
TOOLS_LOG_PATH=/var/log/manager-bot-tools.jsonl

# Master-токен для тестирования моделей (ВЫБОР_МОДЕЛИ.md § 4).
# Это отдельный ключ от production OPENROUTER_API_KEY.
# OPENROUTER_TEST_TOKEN=sk-or-v1-test-...
