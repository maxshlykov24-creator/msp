# ── Скопируй в .env и заполни ──────────────────────────────────────────────

# AssemblyAI — распознавание речи (и опционально оценка). Один ключ на всё.
# Регистрация по реф-ссылке (даёт бонус на баланс): https://assemblyai.cello.so/61A0jvRYzVU
# Ключ берётся в личном кабинете AssemblyAI после пополнения.
ASSEMBLYAI_API_KEY=
ASR_LANGUAGE=ru

# Telegram — куда падает транскрипт. Бот создаётся у @BotFather, chat_id — твой/канала/группы.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── CRM (заполни ОДНУ, под свою систему) ───────────────────────────────────

# AmoCRM: поддомен (xxx.amocrm.ru → xxx) + долгосрочный токен интеграции.
# Нужны, только если ссылку на запись приходится дотягивать через API.
AMOCRM_SUBDOMAIN=
AMOCRM_LONG_TOKEN=

# Bitrix24: входящий вебхук вида https://<portal>.bitrix24.ru/rest/<user_id>/<secret>/
# Обязателен: ссылку на запись Bitrix отдаёт только через API (voximplant.statistic.get).
BITRIX_WEBHOOK_BASE=

# Дублировать транскрипт/оценку примечанием обратно в CRM (по умолчанию выкл — выход только в Telegram).
CRM_WRITEBACK=false

# ── Оценка звонка (опционально) ────────────────────────────────────────────
# false = только транскрибация (базовый режим). true = транскрипт + оценка по company_context.md.
LLM_ENABLED=false
LLM_MODEL=claude-sonnet-4-5-20250929
PRESET=coach
COMPANY_CONTEXT_PATH=company_context.md

# ── Сеть (опционально) ─────────────────────────────────────────────────────
# Прокси (exit-node) для AssemblyAI/Telegram, если сервер в РФ и они заблокированы.
# Пусто = ходим напрямую. Формат: http://user:pass@host:port
HTTPS_PROXY=
