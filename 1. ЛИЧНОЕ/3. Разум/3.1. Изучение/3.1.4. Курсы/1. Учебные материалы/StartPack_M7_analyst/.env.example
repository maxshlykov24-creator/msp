# Аналитик · переменные окружения. Скопируй в .env (не коммить!).

# ── Модель через OpenRouter (один ключ; для batch/автомата и пресета) ──
OPENROUTER_API_KEY=               # openrouter.ai/keys (оплата из РФ: pdpai.ru / WantToPayBot)
# В Cursor модель выбирается в UI; для пакетного прогона/пресета — берётся отсюда.
# Аккуратность с цифрами:  openrouter/anthropic/claude-sonnet-4.6
# Дёшево для простых срезов: openrouter/google/gemini-2.5-flash-lite
ANALYST_MODEL=openrouter/anthropic/claude-sonnet-4.6

# ── Тумблер ревью ──
REVIEW_BEFORE_PUBLISH=true        # true = показать дашборд и ждать «ок»; false = автоотправка

# ── Опционально: источник Яндекс.Метрики (трафик/конверсии лендинга) ──
# YANDEX_METRIKA_TOKEN=           # oauth.yandex.ru → токен счётчика (read-only)

# ── Только для бот-пресета (надстройка, отчёты в Telegram) ──
# TELEGRAM_BOT_TOKEN=             # токен бота-аналитика (@BotFather)
# TELEGRAM_CHAT_ID=               # куда слать отчёт: свой тест-чат, потом канал команды (@channel или -100…)
