TELEGRAM_BOT_TOKEN=your_bot_token
NEXARA_API_KEY=your_nexara_key
TRANSCRIBE_TIMEOUT_SEC=180
YOUTUBE_DOWNLOAD_TIMEOUT_SEC=900
# 0 — без лимита размера входящих файлов / скачанного с YouTube (байты). Пример: 20971520 = 20 МБ.
MAX_FILE_SIZE=0
# Для docker compose: в compose уже задано http://pot:4416.
# Локально с только контейнером pot: YT_POT_PROVIDER_URL=http://127.0.0.1:4416
YT_POT_PROVIDER_URL=http://pot:4416

# Groq — текстовый собеседник (бесплатный tier на console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# LLM_SYSTEM_PROMPT=...
# LLM_TIMEOUT_SEC=120
# Ночной сброс истории LLM (0 = выкл.; при саммаризации обычно не нужен)
LLM_DAILY_RESET_ENABLED=0
LLM_DAILY_RESET_TZ=Europe/Moscow
LLM_DAILY_RESET_HOUR=0
LLM_DAILY_RESET_MINUTE=0
LLM_DAILY_RESET_NOTIFY=1
# Когда записей в history.json больше порога — сжимаются первые LLM_SUMMARIZE_BATCH сообщений в выжимку
LLM_SUMMARIZE_THRESHOLD=40
LLM_SUMMARIZE_BATCH=30
# LLM_SUMMARIZE_SYSTEM_PROMPT=...
